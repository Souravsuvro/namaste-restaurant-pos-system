# ============================================================
# Namaste Gien — POS System Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env — it is gitignored
# ============================================================

# Node
NODE_ENV=production
PORT=3000
SOCKET_PORT=3001

# Database
DATABASE_URL=your_database_connection_string
DB_HOST=localhost
DB_PORT=5432
DB_NAME=namaste_gien_pos
DB_USER=pos_user
DB_PASSWORD=your_secure_password_here

# Authentication
JWT_SECRET=generate_with_openssl_rand_base64_64
SESSION_SECRET=generate_with_openssl_rand_base64_64

# Printer IPs (local network — configure per installation)
KITCHEN_PRINTER_IP=192.168.1.100
BAR_PRINTER_IP=192.168.1.101
RECEIPT_PRINTER_IP=192.168.1.102

# Shopify Integration (sync with namaste-resto)
SHOPIFY_WEBHOOK_SECRET=from_namaste_resto_env
SHOPIFY_STORE_URL=namastegien.myshopify.com

# Payment (Stripe Terminal for in-person)
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx
STRIPE_TERMINAL_LOCATION=your_terminal_location_id

# Analytics
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
