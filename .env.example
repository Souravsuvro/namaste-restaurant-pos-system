# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=./data/pos.db

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_REFRESH_SECRET=change-this-to-another-random-secret
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Tax Rate (France TVA for restaurant)
TAX_RATE=0.10

# Currency
CURRENCY=EUR
CURRENCY_SYMBOL=€

# Restaurant Info
RESTAURANT_NAME=Namaste GIEN
RESTAURANT_ADDRESS=12 Quai de Nice, 45500 Gien, France
RESTAURANT_PHONE=+33 2 38 XX XX XX
RESTAURANT_EMAIL=contact@namastegien.fr
